{
  "id": "claude-code-config-bind-mount",
  "version": "1.0.0",
  "name": "Claude Code Config Bind Mount",
  "description": "Mounts the host ~/.claude directory to /mnt/claude-dir and sets CLAUDE_CONFIG_DIR so Claude Code reads and writes config there regardless of the container username. Fixes a bug where absolute plugin paths stored by Claude Code don't resolve when host and container usernames differ.",
  "options": {},
  "mounts": [
    {
      "source": "${localEnv:HOME}/.claude",
      "target": "/mnt/claude-dir",
      "type": "bind",
      "consistency": "cached"
    },
    {
      "source": "${localEnv:HOME}/.claude.json",
      "target": "/mnt/claude-json",
      "type": "bind",
      "consistency": "cached"
    }
  ],
  "onCreateCommand": "bash /usr/local/share/claude-code-config-bind-mount/onCreate.sh",
  "postCreateCommand": "mkdir -p ${localEnv:HOME} && ln -s /mnt/claude-dir ${localEnv:HOME}/.claude",
  "installsAfter": [
    "ghcr.io/stu-bell/devcontainer-features/claude-code",
    "ghcr.io/anthropics/devcontainer-features/claude-code",
    "ghcr.io/devcontainers-extra/features/claude-code",
    "ghcr.io/devcontainers/features/common-utils"
  ]
}
